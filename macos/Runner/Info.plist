<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>אפליקציית Fantastic משתמשת במצלמה כדי לסרוק תוויות מזון ולנתח אותן לפי עקרונות קטו. הניתוח מתבצע כולו על המכשיר והתמונות אינן נשלחות לשום שרת.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>אפליקציית Fantastic מבקשת גישה לגלריה כדי לייבא תמונות של תוויות מזון לניתוח. הניתוח מתבצע כולו על המכשיר והתמונות אינן נשלחות לשום שרת.</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>he</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>he</string>
		<string>en</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<!--
	  Named, not empty. The asset catalogue already builds an AppIcon from
	  ASSETCATALOG_COMPILER_APPICON_NAME, but an empty CFBundleIconFile
	  leaves macOS with nothing to resolve outside that path - which is why
	  the Flutter template ships it blank and nobody notices until a build
	  lands somewhere that reads the plist first (#92).
	-->
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
