# The repository has never had one of these, so CocoaPods has never resolved a
# single native dependency for the iOS target. `flutter build ios` writes a
# throwaway Podfile from the same template when one is missing, which means the
# resolution nobody has ever reviewed would be regenerated on every machine.
# Committing it makes the native dependency set reviewable and identical
# everywhere — the same argument #159 made for `pubspec.lock`.
#
# Pinned to 15.0 to match IPHONEOS_DEPLOYMENT_TARGET in
# Runner.xcodeproj/project.pbxproj. Every pod in the graph asks for less —
# camera_avfoundation, image_picker_ios and flutter_local_notifications want
# 13.0, SwiftyTesseract (pulled in by flutter_tesseract_ocr) wants 11.0 — so
# 15.0 is the floor the app sets, not one a dependency forces. Leaving it
# commented out lets each pod inherit its own minimum and produces a project
# whose pods disagree with the app about the deployment target.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
